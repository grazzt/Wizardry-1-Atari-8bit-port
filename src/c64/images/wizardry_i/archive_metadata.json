96d9eb0489ee0c5550d5736c3b5d","crc32":"79bddd75","sha1":"efe62b766cac53bde1521a79a19f3232d230efb8","format":"JPEG","rotation":"0"},{"name":"screenshot_01_thumb.jpg","source":"derivative","format":"JPEG Thumb","original":"screenshot_01.jpg","mtime":"1537777694","size":"1207","md5":"a2881b5465ddc0d0c60af7d0bd8efd4d","crc32":"4e9f1de4","sha1":"bfbd15811ad46e1d9ad7537d788157e7ee47a8ef"},{"name":"screenshot_02.jpg","source":"original","mtime":"1537777667","size":"33401","md5":"ca6ddc9597c61750475771c6464dbe83","crc32":"c2937771","sha1":"06a0ecbf129bde7140ffa482e5a1ee2acd606ff8","format":"JPEG","rotation":"0"},{"name":"screenshot_02_thumb.jpg","source":"derivative","format":"JPEG Thumb","original":"screenshot_02.jpg","mtime":"1537777695","size":"2469","md5":"ee1db95608b5ecaf254d0a013d10da8c","crc32":"ef1b00a7","sha1":"26b81ec4c05079b36cb861db3b3e2fb6531389ce"}],"files_count":17,"item_last_updated":1774219202,"item_size":1023108,"metadata":{"identifier":"d64_Wizardry_I_Proving_Grounds_of_the_Mad_Overlord_1982_Sir-Tech_Side_A","collection":["softwarelibrary_c64_games","softwarelibrary_c64","softwarelibrary","emulation"],"description":" Wizardry I   Proving Grounds of the Mad Overlord (1982)(Sir Tech)(Side A) <p></p><p><b>NOTE: This emulation has multiple disk images. To switch between them, press ALT-8 and select among the .d64 filenames to load that floppy into the drive.</b></p><br /><br /><div class=\"mobygames_description\"><p><b>Developed by</b><br /><a href=\"https://archive.org/search.php?query=mobygames_developed_by%3A(Sir-tech%20Software,%20Inc.)\" rel=\"ugc nofollow\">Sir-tech Software, Inc.</a><br /><b>Released</b><br /><a href=\"https://archive.org/search.php?query=mobygames_released%3A(1987)\" rel=\"ugc nofollow\">1987</a><br /><b>Also For</b><br /><a href=\"https://archive.org/search.php?query=mobygames_also_for%3A(Apple%20II,%20Commodore%20128,%20FM-7,%20Game%20Boy%20Color,%20Macintosh,%20MSX,%20NES,%20PC-88,%20PC-98,%20PC%20Booter,%20Sharp%20X1,%20WonderSwan%20Color)\" rel=\"ugc nofollow\">Apple II, Commodore 128, FM-7, Game Boy Color, Macintosh, MSX, NES, PC-88, PC-98, PC Booter, Sharp X1, WonderSwan Color</a><br /><b>Published by</b><br /><a href=\"https://archive.org/search.php?query=mobygames_published_by%3A(Sir-tech%20Software,%20Inc.)\" rel=\"ugc nofollow\">Sir-tech Software, Inc.</a><br /></p><p><b>Perspective</b><br /><a href=\"https://archive.org/search.php?query=mobygames_perspective%3A(1st-person)\" rel=\"ugc nofollow\">1st-person</a><br /><b>Pacing</b><br /><a href=\"https://archive.org/search.php?query=mobygames_pacing%3A(Turn-based)\" rel=\"ugc nofollow\">Turn-based</a><br /><b>Genre</b><br /><a href=\"https://archive.org/search.php?query=mobygames_genre%3A(Role-Playing%20(RPG))\" rel=\"ugc nofollow\">Role-Playing (RPG)</a><br /><b>Setting</b><br /><a href=\"https://archive.org/search.php?query=mobygames_setting%3A(Fantasy)\" rel=\"ugc nofollow\">Fantasy</a><br /></p><p><b>Description</b></p><p>The Mad Overlord Trebor was once only power-mad, but went off the deep end after he acquired a magical amulet of immense power, only to have it stolen from him by his nemesis, the evil archmage Werdna. Werdna, not quite sure how to use the amulet properly, accidentally causes an earthquake which creates a ten-level dungeon beneath Trebor's castle. To avoid looking silly, Werdna declares the dungeon to be the new lair for him and his monster hordes. Trebor, not to be outdone, declares the labyrinth his new Proving Grounds where adventurers must prove themselves for membership in his elite honor guard, and incidentally retrieve his amulet in the process.<br /><br />The first <i>Wizardry</i> was one of the original dungeon-crawling role-playing games, and stands along with <a href=\"https://www.mobygames.com/search/quick?gamegroup=Ultima\" rel=\"ugc nofollow\"> Ultima</a> and <a href=\"https://www.mobygames.com/search/quick?gamegroup=Might+Magic\" rel=\"ugc nofollow\"> Might & Magic</a> as one of the defining staples of the genre.<br /><br />The player generates and control a party of up to six different adventurers, choosing from four races (humans, elves, dwarves, gnomes and hobbits), three alignments (good, neutral and evil), and four basic classes (fighter, priest, mage and thief). These can later evolve into elite classes (bishop: priest with mage spells; samurai: fighter with mage spells; lord: fighter with priest spells, and ninja: fighter with thief abilities) if they meet the necessary level requirements. After outfitting the party with basic weapons and armor, the player sends it into a 3D vector maze-like dungeon to fight monsters in turn-based combat and find treasure.</p><p>From Mobygames.com. <a href=\"https://www.mobygames.com/game/c64/wizardry-proving-grounds-of-the-mad-overlord\" rel=\"ugc nofollow\">Original Entry</a></p></div><div class=\"end_mobygames_description\"></div><br /><div></div>","emulator":"vice-resid","emulator_ext":"d64","emulator_start":"Wizardry_I_Proving_Grounds_of_the_Mad_Overlord_1982_Sir-Tech_Side_A.d64","language":"eng","mediatype":"software","scanner":"Internet Archive Python library 1.8.1","title":"Wizardry I: Proving Grounds of the Mad Overlord (Side A)","publicdate":"2018-09-15 10:19:51","uploader":"sketch@cow.net","addeddate":"2018-09-15 10:19:51","creator":"Sir-Tech","date":"1982\r","mobygames":"https://www.mobygames.com/game/c64/wizardry-proving-grounds-of-the-mad-overlord","wikipedia":"https://en.wikipedia.org/wiki/Wizardry:_Proving_Grounds_of_the_Mad_Overlord","vice_drive_8_fliplist":"Wizardry_I_Proving_Grounds_of_the_Mad_Overlord_1982_Sir-Tech_Side_A.d64; Wizardry_I_Proving_Grounds_of_the_Mad_Overlord_1982_Sir-Tech_Side_B.d64","mobygames_also_for":"Apple II, Commodore 128, FM-7, Game Boy Color, Macintosh, MSX, NES, PC-88, PC-98, PC Booter, Sharp X1, WonderSwan Color","mobygames_developed_by":"Sir-tech Software, Inc.","mobygames_setting":"Fantasy","mobygames_published_by":"Sir-tech Software, Inc.","mobygames_released":"1987","mobygames_pacing":"Turn-based","mobygames_perspective":"1st-person","mobygames_genre":"Role-Playing (RPG)","backup_location":"ia906801_35","collection_added":"emulation"},"server":"ia803102.us.archive.org","uniq":337037187,"workable_servers":["ia803102.us.archive.org","ia903102.us.archive.org"]}